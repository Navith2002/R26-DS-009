VITE_API_BASE_URL=http://127.0.0.1:8000
# Grammar-check, fluency-profiling, and reading-error all run as
# routers/sub-apps on the same shared backend/port as above (see
# backend/grammar_router.py, backend/fluency_router.py,
# backend/reading_error_router.py) -- only set these if you need to point
# one of them somewhere different from VITE_API_BASE_URL.
# VITE_GRAMMAR_API_BASE_URL=http://127.0.0.1:8000
# VITE_FLUENCY_API_BASE_URL=http://127.0.0.1:8000
# VITE_READING_ERROR_API_BASE_URL=http://127.0.0.1:8000
